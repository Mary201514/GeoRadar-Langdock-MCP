[
  {
    "name": "show_georadar_map",
    "title": "Mangold GeoRadar – Firmen auf Karte anzeigen",
    "description": "Zeigt übergebene Unternehmen auf der echten MapLibre-Karte für Deutschland und Österreich. Status existing=blau/Bestandskunde, prospect=weiß/potenziell, priority=rot/besonders interessant, unknown=grau/ungeklärt. Jede Übergabe ersetzt den gesamten Bestand. Nur belegte Koordinaten übergeben; ohne Koordinaten wird ein zweistelliges postalPrefix oder eine zweistellige postalCode als schematischer PLZ-Gebietspunkt nach GeoNames angezeigt, ausdrücklich kein Firmenstandort. Ohne passende Referenz bleibt die Firma in der Liste. locationAccuracy exact nur bei geprüftem Firmenstandort, sonst approximate oder unknown. Kein automatisches Geocoding und keine erfundenen Marktpotenziale. Alte category Bestandskunde/Neukunde wird unterstützt.",
    "inputSchema": {
      "type": "object",
      "required": [
        "records"
      ],
      "properties": {
        "schema": {
          "const": "mangold-georadar/companies/v1"
        },
        "records": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "country"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "country": {
                "enum": [
                  "Deutschland",
                  "Österreich",
                  "DE",
                  "AT"
                ]
              },
              "status": {
                "enum": [
                  "existing",
                  "prospect",
                  "priority",
                  "unknown",
                  "Bestandskunde",
                  "Neukunde",
                  "Potenzieller Neukunde",
                  "Besonders interessant",
                  "Status ungeklärt"
                ]
              },
              "category": {
                "enum": [
                  "Bestandskunde",
                  "Neukunde"
                ]
              },
              "lon": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 5,
                "maximum": 18
              },
              "lat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 46,
                "maximum": 56
              },
              "locationAccuracy": {
                "enum": [
                  "exact",
                  "approximate",
                  "unknown"
                ]
              },
              "leadScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "revenue": {
                "type": "number",
                "minimum": 0
              },
              "customerNumber": {
                "type": "string",
                "maxLength": 4000
              },
              "street": {
                "type": "string",
                "maxLength": 4000
              },
              "postalCode": {
                "type": "string",
                "maxLength": 4000
              },
              "postalPrefix": {
                "type": "string",
                "pattern": "^[0-9]{2}$",
                "description": "Zweistelliges PLZ-Präfix; ohne Firmenkoordinaten nur ein schematischer Gebietspunkt nach GeoNames."
              },
              "city": {
                "type": "string",
                "maxLength": 4000
              },
              "state": {
                "type": "string",
                "maxLength": 4000
              },
              "district": {
                "type": "string",
                "maxLength": 4000
              },
              "industry": {
                "type": "string",
                "maxLength": 4000
              },
              "product": {
                "type": "string",
                "maxLength": 4000
              },
              "potential": {
                "type": "string",
                "maxLength": 4000
              },
              "contact": {
                "type": "string",
                "maxLength": 4000
              },
              "notes": {
                "type": "string",
                "maxLength": 4000
              },
              "relationships": {
                "type": "string",
                "maxLength": 4000
              },
              "coordinateSource": {
                "type": "string",
                "maxLength": 4000
              },
              "personnelNumber": {
                "type": "string",
                "maxLength": 4000
              },
              "salesRep": {
                "type": "string",
                "maxLength": 4000
              },
              "reason": {
                "type": "string",
                "maxLength": 4000
              },
              "opportunity": {
                "type": "string",
                "maxLength": 4000
              },
              "website": {
                "type": "string",
                "maxLength": 2000,
                "description": "Öffentliche http/https-Unternehmenswebsite, keine Zugangsdaten."
              },
              "sources": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              },
              "isFictional": {
                "type": "boolean",
                "description": "Im Dummy-Modus zwingend true. Niemals reale Firmen als fiktiv kennzeichnen."
              },
              "needsReview": {
                "type": "boolean"
              }
            }
          }
        },
        "territories": {
          "type": "array",
          "maxItems": 5,
          "description": "Optionale vollständige Gebietszuordnung. Ohne Angabe bleiben die aktuellen Gebiete bestehen. Standard-Personalnummern CO=93, SR=42, SH=11, GD=2, GK=10; PLZ noch nicht zugeordnet.",
          "items": {
            "type": "object",
            "required": [
              "code",
              "personnelNumber",
              "rules"
            ],
            "properties": {
              "code": {
                "enum": [
                  "CO",
                  "SR",
                  "SH",
                  "GD",
                  "GK"
                ]
              },
              "personnelNumber": {
                "type": "string",
                "maxLength": 100
              },
              "rules": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "country",
                    "prefixes"
                  ],
                  "properties": {
                    "country": {
                      "enum": [
                        "DE",
                        "AT"
                      ]
                    },
                    "prefixes": {
                      "type": "array",
                      "maxItems": 200,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9]{1,5}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://georadar/map-v4.html"
      }
    }
  },
  {
