  {
    "name": "load_georadar_research",
    "title": "Gespeicherte GeoRadar-Recherche laden",
    "description": "Lädt genau eine bekannte Recherchekennung aus Supabase über die geschützte MCP-Verbindung; kein Auflisten aller Kennungen.",
    "inputSchema": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{2,31}$",
          "description": "Selbst gewählte eindeutige Recherchekennung, z. B. AB382. Kein Passwort."
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
