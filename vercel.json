{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "georadar-v2/dist",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "georadar-v2/{dist/**,mcp/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "/api/mcp"
    }
  ]
}
