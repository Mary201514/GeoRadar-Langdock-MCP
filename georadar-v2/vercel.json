{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "{dist/**,mcp/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/", "destination": "/api/mcp" }
  ]
}
