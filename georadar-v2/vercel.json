{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "{dist/**,mcp/**,backend/**}",
      "maxDuration": 60
    },
    "api/research.mjs": {
      "includeFiles": "{dist/**,backend/**}",
      "maxDuration": 30
    },
    "api/auth.mjs": {
      "includeFiles": "{dist/**,backend/**}",
      "maxDuration": 30
    },
    "api/views.mjs": {
      "includeFiles": "{dist/**,backend/**}",
      "maxDuration": 30
    },
    "api/karte.mjs": {
      "includeFiles": "{dist/**,backend/**}",
      "maxDuration": 30
    },
    "api/route.mjs": {
      "includeFiles": "{dist/**,backend/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "/api/mcp"
    },
    {
      "source": "/k/:key([A-Za-z0-9_-]{22,64})",
      "destination": "/index.html"
    },
    {
      "source": "/:code([A-Za-z][A-Za-z0-9-]{2,31})",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:code([A-Za-z][A-Za-z0-9-]{2,31})",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/k/:key*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/plz/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "trailingSlash": false
}
